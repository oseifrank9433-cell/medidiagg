# Required -- the API will refuse to start without these set.
MEDIDIAG_SECRET_KEY=change-this-to-a-long-random-secret
MEDIDIAG_ADMIN_PIN=4821
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Optional -- defaults to a local SQLite file if unset. Set this to your
# Postgres connection string in production (Railway's disk is ephemeral, so
# SQLite there loses all data on every redeploy).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
